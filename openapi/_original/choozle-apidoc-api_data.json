[  {    "type": "post",    "url": "/auth",    "title": "Get Authorization Token",    "version": "1.0.0",    "name": "Auth",    "group": "Authorization",    "parameter": {      "fields": {        "Parameter": [          {            "group": "Parameter",            "type": "<p>string</p> ",            "optional": false,            "field": "email",            "description": "<p>User's email.</p> "          },          {            "group": "Parameter",            "type": "<p>datetime</p> ",            "optional": false,            "field": "timestamp",            "description": "<p>Current datetime in ISO 8601 format, eg. 2015-05-04T11:34:02-06:00. Must be within five minutes of the server's current time.</p> "          },          {            "group": "Parameter",            "type": "<p>string</p> ",            "optional": false,            "field": "signature",            "description": "<p>Signature used to verify your private key. The data to hash should be a string created by concatenating the submitted <code>email</code> and <code>timestamp</code> parameters. Hash this string using an HMAC-SHA256 algorithm with your API private key as the hash key.</p> "          }        ]      }    },    "success": {      "fields": {        "Success 200": [          {            "group": "Success 200",            "type": "<p>string</p> ",            "optional": false,            "field": "token",            "description": "<p>Authentication token to be included in the header of all subsequent API requests. Tokens expires 2 hours after creation, at which point a new one must be generated by re-authenticating.</p> "          }        ]      },      "examples": [        {          "title": "Success-Response:",          "content": "HTTP/1.1 200 OK\n{\n    \"token\": \"c0a011497e5d2f974d05582f33c793688853be6b18a5b68136f41946d612347e\"\n}",          "type": "json"        }      ]    },    "error": {      "fields": {        "Error 4xx": [          {            "group": "Error 4xx",            "optional": false,            "field": "error",            "description": "<p>Request incomplete</p> "          }        ]      },      "examples": [        {          "title": "Error-Response:",          "content": "HTTP/1.1 401 Unauthorized\n{\n    \"error\": \"Request incomplete\"\n}",          "type": "json"        }      ]    },    "filename": "../../../app/Controller/ApiController.php",    "groupTitle": "Authorization"  },  {    "type": "get",    "url": "/accounts",    "title": "Get Account information",    "version": "1.0.0",    "name": "Accounts",    "group": "Reporting",    "header": {      "fields": {        "Header": [          {            "group": "Header",            "type": "string",            "optional": false,            "field": "token",            "description": "<p>Authentication token generated from <code>/api/auth</code> endpoint.</p> "          }        ]      }    },    "success": {      "fields": {        "Success 200": [          {            "group": "Success 200",            "type": "<p>JSON</p> ",            "optional": false,            "field": "response",            "description": "<p>Array of user's accounts objects, including their campaigns and ad groups.</p> "          }        ],        "Enum Response Fields": [          {            "group": "Enum Response Fields",            "type": "<p>string</p> ",            "optional": false,            "field": "account_state",            "description": "<p><code>A</code>: Active<br> <code>I</code>: Inactive, error with account<br> <code>C</code>: Cancelled<br> <code>P</code>: Paused</p> "          },          {            "group": "Enum Response Fields",            "type": "<p>string</p> ",            "optional": false,            "field": "status",            "description": "<p><code>I</code> Incomplete<br> <code>U</code> Unapproved<br> <code>E</code> Enabled<br> <code>D</code> Disabled<br> <code>S</code> Scheduled<br> <code>W</code> Error<br> <code>O</code> Over Ad Group's Budget<br> <code>B</code> Over Ad Group's Daily Budget<br> <code>C</code> Campaign Over Budget<br> <code>A</code> Campaign Over Daily Budget</p> "          }        ]      },      "examples": [        {          "title": "Success-Response:",          "content": "HTTP/1.1 200 OK\n{\n    \"accounts\": [\n        {\n            \"id\": \"1\",\n            \"name\": \"Acme\",\n            \"account_state\": \"A\",\n            \"campaigns\": [\n                {\n                    \"id\": \"15\",\n                    \"name\": \"June2014\",\n                    \"start_date\": \"2014-06-20\",\n                    \"end_date\": \"2014-07-31\",\n                    \"archived\": \"N\",\n                    \"ad_groups\": [\n                        {\n                            \"id\": \"154\",\n                            \"name\": \"Ad Category\",\n                            \"status\": \"E\"\n                        }\n                    ]\n                }\n            ]\n        }\n    ]\n}",          "type": "json"        }      ]    },    "error": {      "fields": {        "Error 4xx": [          {            "group": "Error 4xx",            "optional": false,            "field": "Unauthorized",            "description": "<p>Token is expired.</p> "          }        ]      },      "examples": [        {          "title": "Error-Response:",          "content": "HTTP/1.1 401 Unauthorized\n{\n    \"error\": \"Unauthorized - Token is expired\"\n}",          "type": "json"        }      ]    },    "filename": "../../../app/Controller/ApiController.php",    "groupTitle": "Reporting"  },  {    "type": "get",    "url": "/reports",    "title": "Get Reports",    "version": "1.0.0",    "name": "Reports",    "group": "Reporting",    "header": {      "fields": {        "Header": [          {            "group": "Header",            "type": "string",            "optional": false,            "field": "token",            "description": "<p>Authentication token generated from <code>/api/auth</code> endpoint.</p> "          }        ]      }    },    "parameter": {      "fields": {        "Parameter": [          {            "group": "Parameter",            "type": "<p>integer</p> ",            "optional": false,            "field": "account_id",            "description": "<p>Required.</p> "          },          {            "group": "Parameter",            "type": "<p>date</p> ",            "optional": false,            "field": "date_start",            "description": "<p>Optional. Set the beginning of the date range (inclusive) in the ISO 8601 format; eg. 2015-05-04. If used without date_end, the request will return valid reports after and including date_start.</p> "          },          {            "group": "Parameter",            "type": "<p>date</p> ",            "optional": false,            "field": "date_end",            "description": "<p>Optional. Set the end of the date range (inclusive) in the ISO 8601 format eg. 2015-05-04. If used without date_start, the request will return valid reports before and including date_end.</p> "          },          {            "group": "Parameter",            "type": "<p>integer</p> ",            "optional": false,            "field": "campaign_id",            "description": "<p>Optional. Cannot be combined with <code>campaign_status</code>.</p> "          },          {            "group": "Parameter",            "type": "<p>string</p> ",            "optional": false,            "field": "campaign_status",            "description": "<p>Optional. Cannot be combined with <code>campaign_id</code>. Accepts one of:<br> <code>all</code><br> <code>active</code><br> <code>inactive</code><br> <code>archived</code></p> "          },          {            "group": "Parameter",            "type": "<p>integer</p> ",            "optional": false,            "field": "ad_group_id",            "description": "<p>Optional. Cannot be combined with <code>campaign_id</code> or <code>campaign_status</code>. Accepts one or more id's comma separated.</p> "          }        ]      }    },    "success": {      "fields": {        "Success 200": [          {            "group": "Success 200",            "type": "<p>JSON</p> ",            "optional": false,            "field": "response",            "description": "<p>Array of reports for the given filters. There will be one report per active ad group per day. If no reports were were recorded for an ad group on a particular day, that report is omitted.</p> "          }        ]      },      "examples": [        {          "title": "Success-Response:",          "content": "HTTP/1.1 200 OK\n[\n     {\n         \"date\": \"2014-12-02\",\n         \"account_id\": \"1\",\n         \"account_name\": \"Acme\",\n         \"campaign_id\": \"15\",\n         \"campaign_name\": \"Campaign 1\",\n         \"ad_group_id\": \"154\",\n         \"ad_group_name\": \"Ad Group 1\",\n         \"advertiser_cost\": 0,\n         \"impressions_won\": 3,\n         \"win\": 0,\n         \"cpm\": 0,\n         \"cpc\": 0,\n         \"ctr\": 0,\n         \"cpa\": 0,\n         \"clicks\": 0,\n         \"impressions_bid_on\": 0,\n         \"conversions\": 0\n     }\n ]",          "type": "json"        }      ]    },    "error": {      "fields": {        "Error 4xx": [          {            "group": "Error 4xx",            "optional": false,            "field": "Unauthorized",            "description": "<p>Request token is expired.</p> "          }        ]      },      "examples": [        {          "title": "Error-Response:",          "content": "HTTP/1.1 401 Unauthorized\n{\n    \"error\": \"Unauthorized - Request token is expired.\"\n}",          "type": "json"        }      ]    },    "filename": "../../../app/Controller/ApiController.php",    "groupTitle": "Reporting"  },  {    "success": {      "fields": {        "Success 200": [          {            "group": "Success 200",            "optional": false,            "field": "varname1",            "description": "<p>No type.</p> "          },          {            "group": "Success 200",            "type": "<p>String</p> ",            "optional": false,            "field": "varname2",            "description": "<p>With type.</p> "          }        ]      }    },    "type": "",    "url": "",    "version": "0.0.0",    "filename": "../../../app/webroot/apidoc/main.js",    "group": "_Applications_MAMP_htdocs_Choozle_zipline_zipline_app_webroot_apidoc_main_js",    "groupTitle": "_Applications_MAMP_htdocs_Choozle_zipline_zipline_app_webroot_apidoc_main_js",    "name": ""  },  {    "success": {      "fields": {        "Success 200": [          {            "group": "Success 200",            "optional": false,            "field": "varname1",            "description": "<p>No type.</p> "          },          {            "group": "Success 200",            "type": "<p>String</p> ",            "optional": false,            "field": "varname2",            "description": "<p>With type.</p> "          }        ]      }    },    "type": "",    "url": "",    "version": "0.0.0",    "filename": "../../../app/webroot/apidoc/template/main.js",    "group": "_Applications_MAMP_htdocs_Choozle_zipline_zipline_app_webroot_apidoc_template_main_js",    "groupTitle": "_Applications_MAMP_htdocs_Choozle_zipline_zipline_app_webroot_apidoc_template_main_js",    "name": ""  }]