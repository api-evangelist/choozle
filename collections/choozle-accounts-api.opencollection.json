{
  "opencollection": "1.0.0",
  "info": {
    "name": "Choozle Reporting Accounts API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "token",
      "value": "{{token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Accounts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Account information",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.choozle.com/api/accounts",
            "headers": [
              {
                "name": "token",
                "value": ""
              }
            ]
          },
          "docs": "Returns the array of account objects the authenticated API user can reach, including each account's campaigns and each campaign's ad groups.\n"
        }
      ]
    }
  ],
  "bundled": true
}